CREATE DATABASE hr_analytics;
USE hr_analytics;

DESCRIBE employees;

/* Q1. Calculate the overall employee attrition rate. */

SELECT ROUND(
    (SELECT COUNT(*)
     FROM employees
     WHERE Attrition = 'Yes')
    /
    (SELECT COUNT(*)
     FROM employees) * 100,
    2
) AS Attrition_rate;


/* Q2. Find the total number of employees in each department. */

SELECT Department, COUNT(*) AS Total_Employees
FROM employees
GROUP BY Department;


/* Q3. Find the number of employees who left the company in each department. */

SELECT Department, COUNT(*) AS Left_Employees
FROM employees
WHERE Attrition = 'Yes'
GROUP BY Department;


/* Q4. Calculate the number of employees who left in each department
   using CASE WHEN. */

SELECT
    Department,
    SUM(CASE
        WHEN Attrition = 'Yes' THEN 1
        ELSE 0
    END) AS Left_Employees
FROM employees
GROUP BY Department;


/* Q5. Calculate the attrition rate for each department. */

SELECT
    Department,
    ROUND(
        SUM(CASE
            WHEN Attrition = 'Yes' THEN 1
            ELSE 0
        END) / COUNT(*) * 100,
        2
    ) AS Attrition_Rate
FROM employees
GROUP BY Department;


